<mujoco model="lever">
    <compiler angle="radian" inertiafromgeom="auto" inertiagrouprange="1 5"/>

    <asset>
        <texture name="T_lever_met" type="cube" file="textures/metal1.png"/>

        <material name="lever_col" rgba="0.3 0.3 1.0 0.5" shininess="0" specular="0"/>
        <material name="lever_blue" rgba="0 0 .5 1" shininess="1" reflectance="1" specular="1"/>
        <material name="lever_metal0" rgba=".65 .65 .65 1" texture="T_lever_met" shininess="1" reflectance=".7" specular=".5"/>
        <material name="lever_metal1" rgba=".35 .35 .35 1" texture="T_lever_met" shininess="1" reflectance=".7" specular=".5"/>
    </asset>

    <default>
        <default class="lever_base">
            <joint armature="0.001" damping="2" limited="true"/>
            <geom conaffinity="0" contype="0" group="1" type="mesh"/>
            <position ctrllimited="true" ctrlrange="0 1.57"/>
            <default class="lever_viz">
                <geom condim="4" type="mesh"/>
            </default>
            <default class="lever_col">
                <geom conaffinity="1" condim="3" contype="1" group="4" material="lever_col" solimp="0.99 0.99 0.01" solref="0.01 1"/>
            </default>
            <site type="sphere" size=".01" rgba="0 1 0 1" group="5"/>
        </default>
    </default>

    <asset>
        <mesh file="metaworld/lever/lever_axis.stl" name="lever_axis" scale="0.6 0.6 0.6"/>
        <mesh file="metaworld/lever/lever_base.stl" name="lever_base" scale="0.6 0.6 0.6"/>
        <mesh file="metaworld/lever/lever_handle.stl" name="lever_handle" scale="0.6 0.6 0.6"/>
        <mesh file="metaworld/lever/lever_rod.stl" name="lever_rod" scale="0.6 0.6 0.6"/>
        <mesh file="metaworld/lever/lever_rodbase.stl" name="lever_rodbase" scale="0.6 0.6 0.6"/>
    </asset>

    <worldbody>
        <body childclass="lever_base" name="lever_base" pos="0.58 0.1 -0.01" euler="0 0 -3.14">
            <!-- Static base -->
            <geom material="lever_metal0" euler="0 1.57 0" mesh="lever_base"/>
            <geom class="lever_col" pos="0 0 0.075" size="0.0246 0.0498 0.075" type="box"/>
            <geom class="lever_col" euler="0 1.57 0" pos="0 0 0.15" size="0.0498 0.0246" type="cylinder"/>
            <geom class="lever_col" pos="0 0 0.0078" size="0.03 0.0552 0.0078" type="box"/>

            <!-- Virtual body for target visualization -->
            <body name="lever_link_virtual" pos="0.072 0 0.15">
                <body name="lever_link_virtual_handle" pos="0 -0.12 0">
                    <site name="lever_handle_center_target" pos="0 0 0.0001" group="5"/>
                </body>
            </body>

            <!-- Movable lever handle -->
            <body name="lever_link" pos="0.072 0 0.15">
                <site name="lever_handle_center" pos="0 -0.12 0" group="5"/>
                <joint name="lever_joint" type="hinge" axis="1 0 0" range="0 0.942"/>
                <geom material="lever_metal1" euler="0 1.57 0" mesh="lever_axis"/>
                <geom material="lever_metal0" euler="0 1.57 0" mesh="lever_rodbase"/>
                <geom material="lever_blue" mesh="lever_handle" pos="0 -0.12 0" name="lever_handle"/>
                <geom material="lever_metal1" euler="1.57 0 0" mesh="lever_rod" pos="0 -0.06 0"/>
                <geom class="lever_col" euler="0 1.57 0" size="0.0228 0.0096" type="cylinder"/>
                <geom class="lever_col" euler="1.57 0 0" pos="0 -0.0546 0" size="0.0072 0.06" type="cylinder"/>
                <geom class="lever_col" pos="0 -0.12 0" size="0.018" type="sphere"/>
                <geom class="lever_col" euler="0 1.57 0" pos="-0.015 0 0" size="0.0096 0.0276" type="cylinder"/>
            </body>
        </body>
    </worldbody>
</mujoco>
