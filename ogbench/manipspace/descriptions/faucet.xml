<mujoco model="faucet">
    <compiler angle="radian" inertiafromgeom="auto" inertiagrouprange="1 5"/>

    <asset>
        <texture name="T_fauc_met" type="cube" file="textures/metal2.png"/>

        <material name="faucet_col" rgba="0.3 0.3 1.0 0.5" shininess="0" specular="0"/>
        <material name="faucet_handle" rgba=".5 .1 .1 1" shininess="1" reflectance=".7" specular=".5"/>
        <material name="faucet_body" rgba=".7 .7 .7 1" texture="T_fauc_met" shininess="1" reflectance="1" specular=".5"/>
    </asset>

    <default>
        <default class="faucet_base">
            <joint armature="0.001" damping="2" limited="true"/>
            <geom conaffinity="0" contype="0" group="1" type="mesh"/>
            <position ctrllimited="true" ctrlrange="0 1.57"/>
            <default class="faucet_viz">
                <geom condim="4" type="mesh"/>
            </default>
            <default class="faucet_col">
                <geom conaffinity="1" condim="3" contype="1" group="4" material="faucet_col" solimp="0.99 0.99 0.01" solref="0.01 1"/>
            </default>
            <site type="sphere" size=".01" rgba="0 1 0 1" group="5"/>
        </default>
    </default>

    <asset>
        <mesh file="metaworld/faucet/faucetbase.stl" name="faucetbase"/>
        <mesh file="metaworld/faucet/faucethandle1.stl" name="faucethandle1"/>
        <mesh file="metaworld/faucet/faucethead.stl" name="faucethead"/>
    </asset>

    <worldbody>
        <body childclass="faucet_base" name="faucet_base" pos="0.3 -0.2 0.084">
            <!-- Static base geoms -->
            <geom material="faucet_body" mesh="faucetbase" pos="0 0 0.088"/>
            <geom class="faucet_col" pos="0 0 0.009" size="0.046 0.009" type="cylinder"/>
            <geom class="faucet_col" pos="0 0 0.061" size="0.017 0.044" type="cylinder"/>

            <!-- Virtual handle for target visualization -->
            <body name="faucet_link_virtual" pos="0 0 0.124">
                <body name="faucet_link_virtual_handle" pos="0 -0.175 0">
                    <site name="faucet_handle_center_target" pos="0 0 0.0001" group="5"/>
                </body>
            </body>

            <!-- Movable knob body -->
            <body name="faucet_link" pos="0 0 0.124">
                <site name="faucet_handle_center" pos="0 -0.175 0" group="5"/>
                <joint name="faucet_knob" type="hinge" range="-1.57 1.57" axis="0 0 1"/>
                <geom material="faucet_body" euler="1.57 0 0" mesh="faucethandle1" pos="0 -0.06 0.001"/>
                <geom material="faucet_body" mesh="faucethead" pos="0 0 0.001"/>
                <geom material="faucet_handle" euler="1.57 0 0" pos="0 -0.12 0.001" size="0.017 0.055" type="capsule" name="faucet_handle_geom"/>

                <geom class="faucet_col" euler="1.57 0 0" pos="0 -0.05 0.001" size="0.012 0.021" type="cylinder"/>
                <geom class="faucet_col" euler="1.57 0 0" pos="0 -0.12 0.001" size="0.017 0.055" type="capsule"/>
                <geom class="faucet_col" pos="0 0 0.001" size="0.032 0.02" type="cylinder"/>
            </body>
        </body>
    </worldbody>
</mujoco>
